{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.property.ts",
    "**/*.d.ts"
  ],
  "rules": [
    {
      "id": "raw-effect",
      "pattern": "\\buse(Layout)?Effect\\s*\\(",
      "allow": [
        "src/platform/**"
      ],
      "message": "生の useEffect / useLayoutEffect は使わない。派生値はレンダー中に計算し、操作の結果はイベントハンドラで処理する。外部システムとの同期が本当に必要なら、src/platform/ に名前付きフック（例: useInterval）を作り、そのフックをテストしてから使う。",
      "examples": {
        "bad": [
          "useEffect(() => { setTotal(sum(items)); }, [items]);",
          "useLayoutEffect(() => measure(ref), []);"
        ],
        "good": [
          "const total = sum(items);",
          "useInterval(tick, restSeconds * 1000);"
        ]
      }
    },
    {
      "id": "raw-timer",
      "pattern": "\\b(setTimeout|setInterval|requestAnimationFrame|requestIdleCallback)\\s*\\(",
      "allow": [
        "src/platform/**"
      ],
      "message": "タイマーでタイミングを合わせない。順序の問題はデータフローと状態遷移を直して解消する。時間そのものが仕様（休憩タイマー等）なら src/platform/ のスケジューラ抽象を使う。",
      "examples": {
        "bad": [
          "setTimeout(() => setOpen(true), 100);",
          "requestAnimationFrame(update);"
        ],
        "good": [
          "clearTimeout(handle);",
          "scheduler.after(restDuration, notify);"
        ]
      }
    },
    {
      "id": "explicit-any",
      "pattern": "(:\\s*any\\b|\\bas\\s+any\\b|<\\s*any\\b|\\bany\\s*\\[\\]|[|&,=]\\s*any\\b(?!\\s*[:=(]))",
      "message": "any で型を消さない。外部入力は境界で unknown として受け、パース関数で型を確定させる。lint（typescript/no-explicit-any）が使えるプロジェクトでは、構文木で検出するそちらも有効にする。",
      "examples": {
        "bad": [
          "function parse(input: any) {",
          "const value = data as any;",
          "const rows: any[] = [];",
          "const list: Array<any> = [];",
          "type Input = string | any;"
        ],
        "good": [
          "function parse(input: unknown): Workout {",
          "const options = { many: anything };",
          "const map = new Map<string, unknown>();"
        ]
      }
    },
    {
      "id": "type-escape",
      "pattern": "(@ts-ignore|@ts-expect-error|@ts-nocheck|\\bas\\s+unknown\\s+as\\b)",
      "message": "型エラーを抑制・二重キャストで黙らせない。型定義かデータの形を直す。",
      "examples": {
        "bad": [
          "// @ts-ignore",
          "const user = value as unknown as User;"
        ],
        "good": [
          "const user = parseUser(value);"
        ]
      }
    },
    {
      "id": "lint-suppression",
      "pattern": "(eslint-disable|oxlint-disable|biome-ignore)",
      "message": "lint を無効化しない。ルールが誤っているなら設定の変更を人間に提案し、正しいならコードを直す。",
      "examples": {
        "bad": [
          "// eslint-disable-next-line no-console",
          "/* oxlint-disable */"
        ],
        "good": [
          "logger.info(\"started\");"
        ]
      }
    },
    {
      "id": "excuse-comment",
      "pattern": "(//|/\\*|^\\s*\\*).*(TODO|FIXME|HACK|XXX|[Ww]orkaround|暫定|とりあえず|後で直|あとで直|一時的|回避)",
      "message": "その場しのぎを説明するコメントを書かない。根本原因を直すか、直せない理由と影響を Issue に記録して人間に判断を求める。",
      "examples": {
        "bad": [
          "// TODO: 後で直す",
          "// workaround for the race",
          "/* 暫定対応 */"
        ],
        "good": [
          "// 税率は請求日の法令に従う。再発行でも変えない。",
          "const todoList = loadTodos();"
        ]
      }
    },
    {
      "id": "code-comment",
      "pattern": "^(?!\\s*(///\\s*<reference|//\\s*@vitest-environment|/\\*\\*?\\s*@jsxImportSource))\\s*(//|/\\*|\\*(\\s|/|$))|\\s//\\s|[\\s(,=]/\\*",
      "message": "コードにコメントを書かない。名前・型・関数の分割で意図を表し、守らせたい制約は lint・型・テストで表す。コメントは古くなり、強制できず、その場しのぎの言い訳の置き場になる。どうしても必要な例外は人間が判断する。",
      "examples": {
        "bad": [
          "// 合計を計算する",
          "/* 古い実装 */",
          " * @param value 入力値",
          "const total = sum(items); // 合計",
          "render(/* inline */ value);"
        ],
        "good": [
          "/// <reference types=\"vite/client\" />",
          "const url = \"https://example.com/api\";",
          "const total = sum(items);"
        ]
      },
      "baseline": "text"
    }
  ]
}
